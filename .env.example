# Pact API: the local testnet stack, or https://api.pactagent.app.
PACT_API_URL=http://127.0.0.1:3001
# Pact dashboard → Developers → API keys → New key (secret). Its merchant receives every payment.
PACT_SECRET_KEY=
# That merchant's address (the x402 payTo).
PACT_MERCHANT_ADDRESS=
# Pact's X402AccountFactory on Whitechain Sepolia (deployment record → x402.factory).
X402_FACTORY_ADDRESS=0xa0Ad49CB5927EB50EAB9E49C269e016F44c8dD33
RPC_URL=https://rpc.testnet.whitechain.io
# Sightline's gas relayer: a key holding a little WBT (vault setup, reservations) and test USDT (faucet).
SIGHTLINE_RELAYER_KEY=
# Test USDT sent once to each new desk.
FAUCET_USDT=2
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.whitechain.io
# OpenAI key for the chat analyst (/chat, Vercel AI SDK). Stays on this server.
OPENAI_API_KEY=
# Optional: the model (default gpt-5.4).
OPENAI_MODEL=
